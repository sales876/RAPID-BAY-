# ---------------------------------------------------------------------------
# JRHQ Car Wash Operations — environment configuration
#
# The application runs in two modes:
#
#   1. DEMO MODE  (no Supabase variables set)
#      Data is seeded and persisted in the browser. Everything works —
#      timers, queue, workers, reports, Excel export. Nothing is written to a
#      server. This is the mode used for client demonstrations.
#
#   2. LIVE MODE  (Supabase variables set)
#      Supabase becomes the system of record, realtime pushes updates to every
#      connected screen, and Google Sheets receives a synchronised copy of
#      every job.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the Google Sheets sync route to read job data.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets sync ---------------------------------------------------
# Service account with edit access to the target spreadsheet.
# Share the spreadsheet with GOOGLE_SHEETS_CLIENT_EMAIL as an Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Jobs
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste the full private key. Newlines may be written as \n.
GOOGLE_SHEETS_PRIVATE_KEY=

# --- Web push notifications ------------------------------------------------
# Lets the browser show a notification even when the tab isn't focused, for
# the "worker gets pinged to accept a job / admin gets pinged when it's done"
# workflow. Generate once with `npx web-push generate-vapid-keys` and set the
# SAME pair everywhere the app runs (local + production) — changing the
# private key invalidates every existing subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Business configuration ----------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME=JRHQ Car Wash
NEXT_PUBLIC_BRANCH_NAME=Main Branch
# Used for all date/time display and for the daily rollover boundary.
NEXT_PUBLIC_TIMEZONE=Asia/Dubai
# Minutes of remaining time at which a job is flagged "Finishing Soon".
NEXT_PUBLIC_FINISHING_SOON_MINUTES=5
